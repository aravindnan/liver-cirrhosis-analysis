# Gemini (https://aistudio.google.com/). Rotate the key that was committed in git history.
GEMINI_API_KEY=
# Check the model name is currently available to your key
GEMINI_MODEL=gemini-2.5-flash

# Roboflow
ROBOFLOW_API_KEY=
# ROBOFLOW_MODEL_ID=liver-yolo/1

# Shared secret; must match ML_SERVICE_TOKEN in the API
ML_SERVICE_TOKEN=

# Hosts this service may download uploaded files from
UPLOAD_HOSTS=res.cloudinary.com

# Development only
# FLASK_DEBUG=1
# HOST=127.0.0.1
# PORT=3005
