# Server
PORT=8000
# Comma-separated browser origins allowed by CORS
CLIENT_ORIGINS=http://localhost:3000

# PostgreSQL connection string. For local development with Docker Compose (see ../docker-compose.yml):
#   postgresql://cirrh0:cirrh0@localhost:5432/cirrh0
DATABASE_URL=
# Optional: a separate database for the integration tests. They delete data, so never point this
# at a database you care about.
# TEST_DATABASE_URL=postgresql://cirrh0:cirrh0@localhost:5432/cirrh0_test

# JWT signing secret, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Python ML service (keep it on a private network)
NLP_BASE_URL=http://localhost:3005/extract
REPORT_BASE_URL=http://localhost:3005/predict
IMAGE_BASE_URL=http://localhost:3005/image
# Shared secret sent as X-Service-Token; must match the ML service
ML_SERVICE_TOKEN=

# Hosts the API will accept uploaded file URLs from
UPLOAD_HOSTS=res.cloudinary.com

# Session cookie. lax works when the web app and API share a site (same domain, any port).
# Use none only for cross-site deployments (requires https).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# NODE_ENV=production

# Log level: fatal, error, warn, info, debug, trace or silent
# LOG_LEVEL=info

# Login and register attempts allowed per IP in 15 minutes (default 20)
# AUTH_RATE_LIMIT=20
# Number of reverse proxies in front of the API, e.g. 1 behind a load balancer. Set this in
# production, otherwise every user shares the proxy's IP and one rate-limit bucket.
# TRUST_PROXY=1
