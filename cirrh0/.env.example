# Base URL of the API. Use /api when the API serves the web app itself (production, see ../DEPLOY.md)
VITE_API_URL=http://localhost:8000
# Cloudinary cloud name used for browser uploads (file URLs must match UPLOAD_HOSTS in the API)
VITE_CLOUDINARY_CLOUDNAME=

# Set to true for the demo or private beta: shows a "use test data only" notice on sign-up, login and the analysis pages
# VITE_DEMO_NOTICE=true
